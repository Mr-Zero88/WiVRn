From 790545d9c7abb17db43885611342da17f239e2e1 Mon Sep 17 00:00:00 2001
From: Sapphire <imsapphire0@gmail.com>
Date: Wed, 26 Aug 2026 06:14:13 -0500
Subject: [PATCH 09/11] a/math: Add m_relation_history_get_clamped

Signed-off-by: Sapphire <imsapphire0@gmail.com>
---
 src/xrt/auxiliary/math/m_relation_history.cpp |  6 ++-
 src/xrt/auxiliary/math/m_relation_history.h   | 23 +++++++-
 src/xrt/auxiliary/math/m_relation_history.hpp | 54 +++++++++++++++++--
 3 files changed, 77 insertions(+), 6 deletions(-)

diff --git a/src/xrt/auxiliary/math/m_relation_history.cpp b/src/xrt/auxiliary/math/m_relation_history.cpp
index 1bc7ffd39..724003a26 100644
--- a/src/xrt/auxiliary/math/m_relation_history.cpp
+++ b/src/xrt/auxiliary/math/m_relation_history.cpp
@@ -78,7 +78,11 @@ try {
 G_CATCH_GUARDS_WITH_RETURN(false)
 
 enum m_relation_history_result
-m_relation_history_get(const m_relation_history *mrh, int64_t at_timestamp_ns, xrt_space_relation *out_relation)
+m_relation_history_get_clamped(const struct m_relation_history *mrh,
+                               int64_t at_timestamp_ns,
+                               int64_t max_extrapolation_ns,
+                               int64_t *out_timestamp_ns,
+                               struct xrt_space_relation *out_relation)
 try {
 	XRT_TRACE_MARKER();
 
diff --git a/src/xrt/auxiliary/math/m_relation_history.h b/src/xrt/auxiliary/math/m_relation_history.h
index e05d0bd1e..6f614f855 100644
--- a/src/xrt/auxiliary/math/m_relation_history.h
+++ b/src/xrt/auxiliary/math/m_relation_history.h
@@ -97,12 +97,33 @@ m_relation_history_push_with_motion_estimation(struct m_relation_history *rh,
  * Read-only operation - doesn't remove anything from the buffer or anything like that - you can call this as often
  * as you want.
  *
+ * @param max_extrapolation_ns Maximum time the pose may be extrapolated to. INT64_MAX means extrapolation is unlimited.
+ * @param out_timestamp_ns Optional out parameter for the timestamp of the pose.
+ * @param out_relation Out parameter for the resulting @ref xrt_space_relation.
+ *
  * @public @memberof m_relation_history
  */
 enum m_relation_history_result
+m_relation_history_get_clamped(const struct m_relation_history *rh,
+                               int64_t at_timestamp_ns,
+                               int64_t max_extrapolation_ns,
+                               int64_t *out_timestamp_ns,
+                               struct xrt_space_relation *out_relation);
+
+/*!
+ * Wrapper for @ref m_relation_history_get_clamped with unlimited extrapolation.
+ *
+ * @copydoc m_relation_history_get_clamped
+ *
+ * @public @memberof m_relation_history
+ */
+static inline enum m_relation_history_result
 m_relation_history_get(const struct m_relation_history *rh,
                        int64_t at_timestamp_ns,
-                       struct xrt_space_relation *out_relation);
+                       struct xrt_space_relation *out_relation)
+{
+	return m_relation_history_get_clamped(rh, at_timestamp_ns, INT64_MAX, NULL, out_relation);
+}
 
 /*!
  * Get the latest report in the buffer, if any.
diff --git a/src/xrt/auxiliary/math/m_relation_history.hpp b/src/xrt/auxiliary/math/m_relation_history.hpp
index 4fa6fb287..8382b0a3a 100644
--- a/src/xrt/auxiliary/math/m_relation_history.hpp
+++ b/src/xrt/auxiliary/math/m_relation_history.hpp
@@ -228,10 +228,13 @@ public: // Methods (thread-unsafe)
 	 * Call with @ref mutex held.
 	 */
 	m_relation_history_result
-	getLocked(timepoint_ns timestamp_ns, T &out_entry) const
+	getLocked(timepoint_ns timestamp_ns, int64_t max_extrapolation_ns, int64_t *out_timestamp_ns, T &out_entry) const
 	{
 		if (this->impl.empty() || timestamp_ns == 0) {
 			// Do nothing. You push nothing to the buffer you get nothing from the buffer.
+			if (out_timestamp_ns) {
+				*out_timestamp_ns = 0;
+			}
 			out_entry = {};
 			return M_RELATION_HISTORY_RESULT_INVALID;
 		}
@@ -249,11 +252,16 @@ public: // Methods (thread-unsafe)
 			// The desired timestamp is after what our buffer contains.
 			// (pose-prediction)
 			// Output flags match the most recent buffer entry.
-			time_duration_ns delta_ns = timestamp_ns - this->impl.back().timestamp;
+			time_duration_ns delta_ns = MIN(timestamp_ns - this->impl.front().timestamp, max_extrapolation_ns);
 			double delta_s = time_ns_to_s(delta_ns);
 
 			U_LOG_T("Extrapolating %f s past the back of the buffer!", delta_s);
 
+			if (out_timestamp_ns) {
+				// We extrapolated to the requested timestamp.
+				*out_timestamp_ns = timestamp_ns + delta_ns;
+			}
+
 			out_entry = this->impl.back().predict(delta_ns);
 			return M_RELATION_HISTORY_RESULT_PREDICTED;
 		}
@@ -261,6 +269,11 @@ public: // Methods (thread-unsafe)
 			// exact match:
 			// Flags copied directly along with everything else.
 			U_LOG_T("Exact match in the buffer!");
+
+			if (out_timestamp_ns) {
+				*out_timestamp_ns = timestamp_ns;
+			}
+
 			out_entry = *it;
 			return M_RELATION_HISTORY_RESULT_EXACT;
 		}
@@ -269,11 +282,17 @@ public: // Methods (thread-unsafe)
 			// The desired timestamp is before what our buffer contains.
 			// (an edge case where somebody asks for a really old pose and we do our best)
 			// Output flags are the same as the input flags for the history entry we use
-			time_duration_ns delta_ns = timestamp_ns - this->impl.front().timestamp;
+			time_duration_ns delta_ns = -MIN(abs(timestamp_ns - this->impl.front().timestamp), max_extrapolation_ns);
 			double delta_s = time_ns_to_s(delta_ns);
+
 			U_LOG_T("Extrapolating %f s before the front of the buffer!", delta_s);
-			out_entry = this->impl.front().predict(delta_ns);
 
+			if (out_timestamp_ns) {
+				// We extrapolated to the requested timestamp.
+				*out_timestamp_ns = timestamp_ns + delta_ns;
+			}
+			
+			out_entry = this->impl.front().predict(delta_ns);
 			return M_RELATION_HISTORY_RESULT_REVERSE_PREDICTED;
 		}
 		U_LOG_T("Interpolating within buffer!");
@@ -283,6 +302,10 @@ public: // Methods (thread-unsafe)
 		const auto &predecessor = *(it - 1);
 		const auto &successor = *it;
 
+		if (out_timestamp_ns) {
+			*out_timestamp_ns = timestamp_ns;
+		}
+
 		// Do the thing.
 		out_entry = predecessor.interpolate(timestamp_ns, successor);
 		return M_RELATION_HISTORY_RESULT_INTERPOLATED;
@@ -359,6 +382,17 @@ public: // Methods (thread-unsafe)
 		return best;
 	}
 
+	/*!
+	 * Gets the device's relation at the specified timestamp. May predict or interpolate to get the closest value.
+	 *
+	 * Call with @ref mutex held.
+	 */
+	m_relation_history_result
+	getLocked(timepoint_ns timestamp_ns, T &out_entry) const
+	{
+		return this->getLocked(timestamp_ns, 0, nullptr, out_entry);
+	}
+
 public: // Methods (thread-safe)
 	/*!
 	 * @copydoc pushOrUpdateLocked
@@ -462,6 +496,18 @@ public: // Methods (thread-safe)
 		std::unique_lock<os::Mutex> lock(this->mutex);
 		return this->getNearestLocked(timestamp_ns, max_slop_ns);
 	}
+
+	/*!
+	 * @copydoc getLocked
+	 *
+	 * Thread safe, holds @ref mutex.
+	 */
+	m_relation_history_result
+	get_clamped(timepoint_ns timestamp_ns, int64_t max_extrapolation_ns, int64_t *out_timestamp_ns, T &out_entry) const
+	{
+		std::unique_lock<os::Mutex> lock(this->mutex);
+		return this->getLocked(timestamp_ns, max_extrapolation_ns, out_timestamp_ns, out_entry);
+	}
 };
 
 using RelationHistory = RelationHistoryBase<RelationHistoryEntry>;
-- 
2.56.1

